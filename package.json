{
  "name": "flint",
  "version": "2.9.1",
  "description": "League of Legends Modding IDE",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite', { recursive: true, force: true }); console.log('cleared node_modules/.vite');\"",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:shaders": "tauri dev --features shaderforge",
    "sync-version": "node scripts/sync-version.js",
    "version:patch": "npm version patch --no-git-tag-version && npm run sync-version",
    "version:minor": "npm version minor --no-git-tag-version && npm run sync-version",
    "version:major": "npm version major --no-git-tag-version && npm run sync-version",
    "release": "node scripts/release.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@babylonjs/core": "^9.9.1",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.9.1",
    "@babylonjs/materials": "^9.9.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@types/react-window": "^1.8.8",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.3",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
